PORT=8080

# World Labs (https://platform.worldlabs.ai)
WORLD_LABS_API_KEY=
WORLD_LABS_API_BASE=https://api.worldlabs.ai

# Gemini
GEMINI_API_KEY=

# Gemini on Vertex AI. Sign in once with `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Nano Banana, for the last step's photos. Defaults to gemini-nano-banana-2.1;
# gemini-3-pro-image (Nano Banana Pro) costs more and draws better. Both are
# served from the global location only.
IMAGE_MODEL=
