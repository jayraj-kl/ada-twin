PORT=8080

# World Labs (https://platform.worldlabs.ai)
WORLD_LABS_API_KEY=
WORLD_LABS_API_BASE=https://api.worldlabs.ai

# Gemini
GEMINI_API_KEY= ## for later adding a fallback support

# Gemini on Vertex AI. Sign in once with `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Nano Banana, for the last step's photos. Defaults to gemini-nano-banana-2.1;
# gemini-3-pro-image (Nano Banana Pro) costs more and draws better. Both are
# served from the global location only.
IMAGE_MODEL= ## to remove insdide the code as well

# Logging. LOG_LEVEL is debug, info, warn or error (default info). LOG_FORMAT
# is pretty or json; it defaults to json in production, which Cloud Logging
# reads as structured entries.
LOG_LEVEL=
LOG_FORMAT=

# Postgres for projects: a local database in development, Cloud SQL in production
DATABASE_URL=postgres://postgres:postgres@localhost:5434/factory_twin

# Cloud Storage bucket for project files (drawings, run logs, uploads)
GCS_BUCKET=gen-lang-client-0447144465-ada-twin-files
# Keeps local development apart inside the shared bucket; unset in production
GCS_PREFIX=dev/
