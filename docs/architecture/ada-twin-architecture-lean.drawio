le="rounded=1;arcSize=3;fillColor=#EFE9DF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="250" y="52" width="220" height="488" as="geometry"/></mxCell><mxCell id="c11" value="FRONT DOOR" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontSize=11;fontStyle=1;fontColor=#6B6259;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="260" y="30" width="220" height="18" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=3;fillColor=#EFE9DF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="490" y="52" width="520" height="488" as="geometry"/></mxCell><mxCell id="c13" value="LONG-RUNNING WORK" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontSize=11;fontStyle=1;fontColor=#6B6259;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="500" y="30" width="520" height="18" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=3;fillColor=#EFE9DF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1030" y="52" width="550" height="488" as="geometry"/></mxCell><mxCell id="c15" value="VERTEX AI" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontSize=11;fontStyle=1;fontColor=#6B6259;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="1040" y="30" width="550" height="18" as="geometry"/></mxCell><mxCell id="c16" value="PLANT &amp;amp; USERS" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontSize=11;fontStyle=1;fontColor=#6B6259;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="210" height="18" as="geometry"/></mxCell><mxCell id="c17" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;Plant manager&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;REACT 19 · THREE.JS&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#6B6259;margin-top:5px&quot;&gt;Walks the 3D twin, sets the scenario, watches the shift live&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=none;strokeColor=none;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="30" y="68" width="190" height="140" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="43" y="82" width="30" height="30" as="geometry"/></mxCell><mxCell id="c19" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;Machine manuals&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;PDF · DATASHEETS · LOGS&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#6B6259;margin-top:5px&quot;&gt;Datasheets and maintenance logs; Gemini reads the specs and failure history&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=none;strokeColor=none;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="30" y="234" width="190" height="120" as="geometry"/></mxCell><mxCell id="c20" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="43" y="248" width="30" height="30" as="geometry"/></mxCell><mxCell id="c21" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;360° capture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;PHONE / 360 CAMERA&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#6B6259;margin-top:5px&quot;&gt;Panoramas of the floor, uploaded through the API&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=none;strokeColor=none;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="30" y="386" width="190" height="118" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="43" y="400" width="30" height="30" as="geometry"/></mxCell><mxCell id="c23" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;Firebase Hosting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;+ IDENTITY PLATFORM&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#6B6259;margin-top:5px&quot;&gt;Web app on the CDN; sign-in per plant&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="260" y="68" width="200" height="108" as="geometry"/></mxCell><mxCell id="c24" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="273" y="82" width="30" height="30" as="geometry"/></mxCell><mxCell id="c25" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;API service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;CLOUD RUN · HONO&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#6B6259;margin-top:5px&quot;&gt;One service for everything quick:&lt;br&gt;&lt;br&gt;• projects and twins&lt;br&gt;• Gemini twin building, scenario chat and equipment scout&lt;br&gt;• Nano Banana redraws&lt;br&gt;• streams the live run to the browser&lt;br&gt;&lt;br&gt;Starts the long work and returns at once.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#FFFDF9;strokeColor=#C2410C;strokeWidth=2.4;" vertex="1" parent="1"><mxGeometry x="260" y="192" width="200" height="332" as="geometry"/></mxCell><mxCell id="c26" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="273" y="206" width="30" height="30" as="geometry"/></mxCell><mxCell id="c27" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;Cloud Workflows&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;3D WORLD PIPELINE&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#6B6259;margin-top:5px&quot;&gt;Starts generation, waits ~12 min with retries, saves the splat and mesh to Cloud Storage&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="504" y="68" width="240" height="150" as="geometry"/></mxCell><mxCell id="c28" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="517" y="82" width="30" height="30" as="geometry"/></mxCell><mxCell id="c29" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;World Labs Marble&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#6B6259;font-weight:bold;letter-spacing:0.3px&quot;&gt;PARTNER API&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#6B6259;margin-top:5px&quot;&gt;One 360° photo → walkable 3D world with metric scale&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#FFFDF9;strokeColor=#A89C8D;strokeWidth=1.2;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="764" y="68" width="232" height="150" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="777" y="82" width="30" height="30" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=1;arcSize=3;fillColor=#5A514A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="516" y="258" width="480" height="266" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;arcSize=3;fillColor=#3A332E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="510" y="253" width="486" height="271" as="geometry"/></mxCell><mxCell id="c33" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#F8F5EF&quot;&gt;Shift simulation  ×N tasks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#FF9A57;font-weight:bold;letter-spacing:0.3px&quot;&gt;CLOUD RUN JOBS&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#CFC6BA;margin-top:5px&quot;&gt;Deterministic discrete-event engine: an 8-hour shift in seconds. One job fans out seeds × scenarios × fixes, one task each.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#1F1B18;strokeColor=#1F1B18;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="504" y="248" width="480" height="266" as="geometry"/></mxCell><mxCell id="c34" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="517" y="262" width="30" height="30" as="geometry"/></mxCell><mxCell id="c35" value="&lt;span style=&quot;font-size:10.5px;font-weight:bold;letter-spacing:0.3px;color:#FF9A57&quot;&gt;AI CREW, INSIDE EVERY TASK · ADK&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="558" y="370" width="400" height="18" as="geometry"/></mxCell><mxCell id="c36" value="&lt;div style=&quot;text-align:center;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#F8F5EF&quot;&gt;Planner&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#CFC6BA&quot;&gt;orders and staffing&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#2E2824;strokeColor=#4A423C;" vertex="1" parent="1"><mxGeometry x="558" y="394" width="128" height="94" as="geometry"/></mxCell><mxCell id="c37" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="604" y="402" width="36" height="36" as="geometry"/></mxCell><mxCell id="c38" value="&lt;div style=&quot;text-align:center;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#F8F5EF&quot;&gt;Technician&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#CFC6BA&quot;&gt;repairs, by risk&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#2E2824;strokeColor=#4A423C;" vertex="1" parent="1"><mxGeometry x="696" y="394" width="128" height="94" as="geometry"/></mxCell><mxCell id="c39" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="742" y="402" width="36" height="36" as="geometry"/></mxCell><mxCell id="c40" value="&lt;div style=&quot;text-align:center;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#F8F5EF&quot;&gt;Supervisor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#CFC6BA&quot;&gt;calls the trade-offs&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;verticalAlign=bottom;spacingBottom=8;fillColor=#2E2824;strokeColor=#4A423C;" vertex="1" parent="1"><mxGeometry x="834" y="394" width="128" height="94" as="geometry"/></mxCell><mxCell id="c41" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="880" y="402" width="36" height="36" as="geometry"/></mxCell><mxCell id="c42" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;Gemini on Vertex AI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;VISION · REASONING · GOOGLE SEARCH GROUNDING&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#5E4B3E;margin-top:5px&quot;&gt;• pins each machine in the 360° panorama&lt;br&gt;• reads manuals and the web for cycle time, MTBF, MTTR&lt;br&gt;• drafts the material flow and the scenario&lt;br&gt;• makes every crew decision, with a reason&lt;br&gt;• scouts new equipment the plant doesn't have&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#FBE3D4;strokeColor=#C2410C;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1044" y="68" width="522" height="210" as="geometry"/></mxCell><mxCell id="c43" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1057" y="82" width="30" height="30" as="geometry"/></mxCell><mxCell id="c44" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;Failure prediction&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;VERTEX AI · AUTOML TABULAR&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#5E4B3E;margin-top:5px&quot;&gt;Learns each machine's time between failures and repair time from the maintenance history in BigQuery, read from the plant's logs. The simulator uses it instead of guesses.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#FBE3D4;strokeColor=#C2410C;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1044" y="298" width="254" height="226" as="geometry"/></mxCell><mxCell id="c45" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1057" y="312" width="30" height="30" as="geometry"/></mxCell><mxCell id="c46" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;Nano Banana&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;GEMINI IMAGE EDITING&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#5E4B3E;margin-top:5px&quot;&gt;Draws the applied fixes, such as an extra boiler, into the plant's own photos.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#FBE3D4;strokeColor=#C2410C;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1312" y="298" width="254" height="226" as="geometry"/></mxCell><mxCell id="c47" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1325" y="312" width="30" height="30" as="geometry"/></mxCell><mxCell id="c48" value="DATA" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontSize=11;fontStyle=1;fontColor=#6B6259;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="30" y="586" width="400" height="18" as="geometry"/></mxCell><mxCell id="c49" value="" style="rounded=1;arcSize=3;fillColor=#EFE9DF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="606" width="1560" height="108" as="geometry"/></mxCell><mxCell id="c50" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;FILES&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#6B6259;margin-top:5px&quot;&gt;Photos, splats, manuals, renders&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="30" y="612" width="190" height="96" as="geometry"/></mxCell><mxCell id="c51" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="43" y="626" width="30" height="30" as="geometry"/></mxCell><mxCell id="c52" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;Cloud SQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;POSTGRESQL&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#6B6259;margin-top:5px&quot;&gt;Projects, twins, flows, fixes&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="260" y="612" width="200" height="96" as="geometry"/></mxCell><mxCell id="c53" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="273" y="626" width="30" height="30" as="geometry"/></mxCell><mxCell id="c56" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;BigQuery&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;WAREHOUSE · BIGQUERY ML&lt;/span&gt;&lt;div style=&quot;font-size:11.5px;color:#6B6259;margin-top:5px&quot;&gt;Runs, KPIs and maintenance history&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=54;spacingRight=10;spacingTop=10;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="504" y="612" width="492" height="96" as="geometry"/></mxCell><mxCell id="c57" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="517" y="626" width="30" height="30" as="geometry"/></mxCell><mxCell id="c58" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:14.5px;color:#1F1B18&quot;&gt;Looker Studio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter