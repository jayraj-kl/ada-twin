:11px;color:#6B6259&quot;&gt;Throughput, downtime and scrap across plants&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="894" y="612" width="216" height="92" as="geometry"/></mxCell><mxCell id="c56" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Firestore&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;LIVE STATE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Run progress, agent decisions and KPIs as they happen; the browser listens in real time&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1144" y="612" width="422" height="92" as="geometry"/></mxCell><mxCell id="c57" value="BUILD &amp;amp; OPERATE" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontSize=11;fontStyle=1;fontColor=#6B6259;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="30" y="718" width="400" height="18" as="geometry"/></mxCell><mxCell id="c58" value="Cloud Build" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#D6CCBE;fontSize=12;fontColor=#1F1B18;" vertex="1" parent="1"><mxGeometry x="30" y="742" width="150" height="36" as="geometry"/></mxCell><mxCell id="c59" value="Artifact Registry" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#D6CCBE;fontSize=12;fontColor=#1F1B18;" vertex="1" parent="1"><mxGeometry 