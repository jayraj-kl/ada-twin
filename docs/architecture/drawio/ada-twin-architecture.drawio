ue="" style="rounded=1;arcSize=3;fillColor=#EFE9DF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="660" y="52" width="450" height="516" as="geometry"/></mxCell><mxCell id="c17" value="WORKERS · CLOUD RUN, AUTOSCALED FROM PUB/SUB" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontSize=11;fontStyle=1;fontColor=#6B6259;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="670" y="30" width="450" height="18" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;arcSize=3;fillColor=#EFE9DF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1130" y="52" width="450" height="516" as="geometry"/></mxCell><mxCell id="c19" value="VERTEX AI &amp;amp; MODELS" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontSize=11;fontStyle=1;fontColor=#6B6259;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="1140" y="30" width="450" height="18" as="geometry"/></mxCell><mxCell id="c20" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Plant manager&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;REACT 19 · THREE.JS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Walks the 3D twin, sets the scenario, watches the shift live&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="30" y="68" width="190" height="120" as="geometry"/></mxCell><mxCell id="c21" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;360° capture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;PHONE / 360 CAMERA&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Panoramas and manuals go straight to Cloud Storage by signed URL&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="30" y="208" width="190" height="104" as="geometry"/></mxCell><mxCell id="c22" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Plant data feeds&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#6B6259;font-weight:bold;letter-spacing:0.3px&quot;&gt;PHASE 2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;PLC and sensor telemetry, MES output counts, CMMS maintenance logs&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#A89C8D;strokeWidth=1.2;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="30" y="375" width="190" height="160" as="geometry"/></mxCell><mxCell id="c23" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Firebase Hosting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;CLOUD CDN · CLOUD ARMOR&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Web app at the edge; WAF in front of the API&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="260" y="68" width="200" height="88" as="geometry"/></mxCell><mxCell id="c24" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Identity Platform&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;SIGN-IN · IAM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;One tenant per plant&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="260" y="167" width="200" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;API service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;CLOUD RUN · HONO&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Validates, writes the job, publishes it, answers 202 with a job id. Never waits on a model.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#C2410C;strokeWidth=2.4;" vertex="1" parent="1"><mxGeometry x="260" y="248" width="200" height="132" as="geometry"/></mxCell><mxCell id="c26" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Cloud Workflows&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;ORCHESTRATION&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Capture → world → twin pipeline: long waits, retries, timeouts&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="260" y="442" width="200" height="110" as="geometry"/></mxCell><mxCell id="c27" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Pub/Sub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold&quot;&gt;TOPICS&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#FFF4EA;strokeColor=#E8752E;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="500" y="68" width="130" height="488" as="geometry"/></mxCell><mxCell id="c28" value="&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#1F1B18&quot;&gt;world.requested&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#E8752E;" vertex="1" parent="1"><mxGeometry x="510" y="120" width="110" height="24" as="geometry"/></mxCell><mxCell id="c29" value="&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#1F1B18&quot;&gt;twin.requested&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#E8752E;" vertex="1" parent="1"><mxGeometry x="510" y="199" width="110" height="24" as="geometry"/></mxCell><mxCell id="c30" value="&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#1F1B18&quot;&gt;sim.jobs&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#E8752E;" vertex="1" parent="1"><mxGeometry x="510" y="298" width="110" height="24" as="geometry"/></mxCell><mxCell id="c31" value="&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#1F1B18&quot;&gt;agent.turns&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#E8752E;" vertex="1" parent="1"><mxGeometry x="510" y="397" width="110" height="24" as="geometry"/></mxCell><mxCell id="c32" value="&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#1F1B18&quot;&gt;render.requested&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#E8752E;" vertex="1" parent="1"><mxGeometry x="510" y="482" width="110" height="24" as="geometry"/></mxCell><mxCell id="c33" value="&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#1F1B18&quot;&gt;run.events&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#E8752E;fillColor=#FBE3D4;" vertex="1" parent="1"><mxGeometry x="510" y="512" width="110" height="24" as="geometry"/></mxCell><mxCell id="c34" value="&lt;span style=&quot;font-family:Courier New;font-size:11px;color:#1F1B18&quot;&gt;telemetry&lt;/span&gt;" style="rounded=1;arcSize=50;html=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=#FFFDF9;strokeColor=#E8752E;dashed=1;" vertex="1" parent="1"><mxGeometry x="510" y="542" width="110" height="24" as="geometry"/></mxCell><mxCell id="c35" value="&lt;span style=&quot;font-size:10px;color:#6B6259&quot;&gt;dead-letter topic + retries on every subscription&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;align=center;" vertex="1" parent="1"><mxGeometry x="510" y="148" width="110" height="30" as="geometry"/></mxCell><mxCell id="c36" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;World builder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;WORKER · world.requested&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Sends the panorama to Marble, stores the Gaussian splat, collision mesh and scale&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="674" y="68" width="422" height="88" as="geometry"/></mxCell><mxCell id="c37" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Twin builder&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;WORKER · twin.requested&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Pins each machine in 3D, reads specs from manuals and the web, drafts the material flow&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="674" y="167" width="422" height="88" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=1;arcSize=6;fillColor=#5A514A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="686" y="276" width="422" height="88" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;arcSize=6;fillColor=#3A332E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="680" y="271" width="422" height="88" as="geometry"/></mxCell><mxCell id="c40" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#F8F5EF&quot;&gt;Simulation workers  ×N&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#FF9A57;font-weight:bold;letter-spacing:0.3px&quot;&gt;CLOUD RUN JOBS · sim.jobs&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#CFC6BA&quot;&gt;Deterministic discrete-event engine. 8-hour shift in seconds; seeds × scenarios × fixes fan out in parallel&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#1F1B18;strokeColor=#1F1B18;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="674" y="266" width="410" height="78" as="geometry"/></mxCell><mxCell id="c41" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Agent crew&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;WORKER · agent.turns&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5E4B3E&quot;&gt;Planner, technician and supervisor decide at each event; decisions go back to the sim&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FBE3D4;strokeColor=#C2410C;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="674" y="365" width="422" height="88" as="geometry"/></mxCell><mxCell id="c42" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Report &amp;amp; redesign&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;WORKER · render.requested&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Ranks fixes by gain, scouts new equipment, redraws the plant photos with the changes&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="674" y="464" width="422" height="88" as="geometry"/></mxCell><mxCell id="c43" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;World Labs Marble&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#6B6259;font-weight:bold;letter-spacing:0.3px&quot;&gt;PARTNER API&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;One 360° photo → explorable 3D world with metric scale&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#A89C8D;strokeWidth=1.2;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="1144" y="68" width="422" height="88" as="geometry"/></mxCell><mxCell id="c44" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Gemini on Vertex AI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;VISION · REASONING&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5E4B3E&quot;&gt;Grounded with Google Search&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FBE3D4;strokeColor=#C2410C;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1144" y="167" width="205" height="88" as="geometry"/></mxCell><mxCell id="c45" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Document AI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;MANUAL PARSING&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Datasheets and PDFs → cycle time, MTBF, MTTR&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1361" y="167" width="205" height="88" as="geometry"/></mxCell><mxCell id="c46" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Vertex AI failure prediction&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;AUTOML TABULAR · MODEL REGISTRY&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5E4B3E&quot;&gt;Trained on maintenance logs in BigQuery; serves MTBF and MTTR per machine to the simulator&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FBE3D4;strokeColor=#C2410C;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1144" y="266" width="422" height="88" as="geometry"/></mxCell><mxCell id="c47" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Vertex AI Agent Engine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;ADK · SESSIONS · MEMORY&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5E4B3E&quot;&gt;Hosts the crew; each agent has a role and a risk persona, and explains every call&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FBE3D4;strokeColor=#C2410C;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1144" y="365" width="422" height="88" as="geometry"/></mxCell><mxCell id="c48" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Gemini image (Nano Banana)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;IMAGE EDITING&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5E4B3E&quot;&gt;Draws the applied changes into the plant's own photos&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FBE3D4;strokeColor=#C2410C;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1144" y="464" width="422" height="88" as="geometry"/></mxCell><mxCell id="c49" value="DATA &amp;amp; ANALYTICS" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;fontSize=11;fontStyle=1;fontColor=#6B6259;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="30" y="586" width="400" height="18" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=1;arcSize=3;fillColor=#EFE9DF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="606" width="1560" height="104" as="geometry"/></mxCell><mxCell id="c51" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;OBJECTS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Panoramas, splats, manuals, renders&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fillColor=#FFFDF9;strokeColor=#D6CCBE;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="30" y="612" width="190" height="92" as="geometry"/></mxCell><mxCell id="c52" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b style=&quot;font-size:14px;color:#1F1B18&quot;&gt;Cloud SQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#C2410C;font-weight:bold;letter-spacing:0.3px&quot;&gt;POSTGRESQL&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B6259&quot;&gt;Projects, twins, flows, fixes&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize