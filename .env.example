# Set PORT, VITE_API_URL in the apps/api & apps/frontend respectively

# Postgres connection string (local Postgres)
DATABASE_URL=

# World Labs (https://platform.worldlabs.ai)
WORLD_LABS_API_KEY=
WORLD_LABS_API_BASE=https://api.worldlabs.ai

# Vertex AI, for the API's agents and the scripts.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Gemini
GEMINI_API_KEY=

# Logging. LOG_LEVEL is debug, info, warn or error (default info). LOG_FORMAT
# is pretty or json; it defaults to json in production, which Cloud Logging
# reads as structured entries.
LOG_LEVEL=
LOG_FORMAT=